# =============================================================================
# Copy to .env.local and fill in. NOTHING in this file is a real secret.
#
# Every key below is sandbox/test-mode only. Live-mode keys are an automatic
# fail on this project and the app refuses to boot if it detects one (see the
# guard in src/lib/env.ts).
# =============================================================================

# --- Database ---------------------------------------------------------------
# Neon Postgres. The pooled connection string for the app, direct for migrations.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- App --------------------------------------------------------------------
# Public origin of the deployed app. Providers post webhooks here, so it must be
# the real https:// URL, not localhost.
APP_BASE_URL=https://your-app.vercel.app
# 32+ random bytes, used to sign session cookies. `openssl rand -base64 32`
SESSION_SECRET=

# --- Alpaca (LIVE integration: brokerage / custody) -------------------------
# Paper trading only. https://app.alpaca.markets -> Paper account -> API keys.
# Using a live key here is an automatic fail.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# Shared secret configured on the Alpaca webhook so we can verify deliveries.
ALPACA_WEBHOOK_SECRET=

# --- Plaid (LIVE integration: funding / open banking) ------------------------
# Sandbox only. https://dashboard.plaid.com -> Team Settings -> Keys.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_SECRET=

# --- KYC (LIVE integration: identity) ---------------------------------------
# Persona sandbox. https://withpersona.com -> Sandbox -> API keys.
# The template must have test flows for approved / pending / declined.
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
PERSONA_ENVIRONMENT_ID=
PERSONA_WEBHOOK_SECRET=

# --- Market data ------------------------------------------------------------
# Alpaca's own data API is used by default (same credentials as above).
# Optional fallback if Alpaca data is unavailable:
POLYGON_API_KEY=

# --- Custodian file simulator (SIMULATED, and labelled as such) -------------
# Our simulated custodian ships a morning positions/cash/transactions file and
# deliberately generates the awkward cases: the late dividend, the corrected
# price, the tampered position.
CUSTODIAN_SIM_SECRET=

# --- Stablecoin payout (STRETCH, testnet only) ------------------------------
# Base Sepolia. Testnet only, never mainnet.
CIRCLE_API_KEY=
BASE_SEPOLIA_RPC_URL=
