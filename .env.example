# =============================================================================
# Copy to .env.local and fill in.
#
# This file lists EVERY key the system needs and NOTHING it does not. A template
# that documents credentials the code never reads is worse than no template: it
# sends whoever is setting this up hunting for secrets that do nothing.
#
# Every credential here is sandbox / test-mode. Live-mode keys, real money and
# real personal data are all out of bounds on this project.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Neon Postgres. Pooled for the app; direct for migrations, because DDL and
# CREATE CONSTRAINT TRIGGER want a real session rather than a pooled one.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- App ---------------------------------------------------------------------
# The public origin of the DEPLOYED app. Providers post webhooks here and the
# app prints its own endpoint URLs from it, so it must be the real https:// URL.
APP_BASE_URL=https://your-app.vercel.app

# Signs session cookies (HMAC-SHA256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# --- Alpaca Broker API (LIVE — brokerage and custody) ------------------------
# Sandbox only: https://broker-app.alpaca.markets -> Sandbox -> API Keys.
# Use "Legacy" credentials, which are a key id + secret used with HTTP Basic.
ALPACA_BROKER_KEY_ID=
ALPACA_BROKER_SECRET=
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets

# Shared secret between scripts/alpaca-bridge.ts and /api/webhooks/alpaca.
#
# Alpaca's Broker sandbox offers no webhook registration (verified: /v1/webhooks,
# /v2/webhooks and /v1/events/subscriptions all 404). Its push transport is SSE,
# so the bridge holds the stream open and posts each event into our endpoint,
# signed with this secret. Generate it the same way as SESSION_SECRET.
ALPACA_WEBHOOK_SECRET=

# --- Plaid (LIVE — bank linking and funding) ---------------------------------
# Sandbox keys: https://dashboard.plaid.com -> Developers -> Keys
#
# The Alpaca processor integration must be enabled at
# https://dashboard.plaid.com/developers/integrations, otherwise
# /processor/token/create returns INVALID_PRODUCT and no ACH relationship can
# be created.
#
# NOTE: Plaid has no webhook secret. It signs webhooks with an ES256 JWT, and
# verification fetches Plaid's public key using the client id and secret below.
# There is deliberately no PLAID_WEBHOOK_SECRET here.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Persona (LIVE — identity verification) ----------------------------------
# Sandbox keys: Persona dashboard -> API. Template id starts with itmpl_.
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=

# Persona dashboard -> Webhooks -> add
#   https://<APP_BASE_URL>/api/webhooks/persona
# and paste the signing secret it issues here. Without it, deliveries are
# recorded as `unverifiable` and deliberately NOT processed — an unverified
# identity decision must never move money.
PERSONA_WEBHOOK_SECRET=
