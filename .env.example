# =============================================================================
# Copy to .env.local and fill in.
#
# This file lists EVERY key the system reads and NOTHING it does not. A template
# that documents credentials the code never reads is worse than no template: it
# sends whoever is setting this up hunting for secrets that do nothing. It had
# drifted — the whole paper-trading block was missing, so a fresh clone could
# open accounts and move cash but not place a single order, and the failure
# surfaced as "insufficient buying power" rather than "you forgot a key".
#
# Verified against `grep -r process.env src/ scripts/ db/`, which is the only
# definition of "needs" that cannot drift.
#
# Every credential here is sandbox / test-mode. Live-mode keys, real money and
# real personal data are all out of bounds on this project.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Neon Postgres. Pooled for the app; direct for migrations, because DDL and
# CREATE CONSTRAINT TRIGGER want a real session rather than a pooled one.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- App ---------------------------------------------------------------------
# The public origin of the DEPLOYED app. Providers post webhooks here and the
# app prints its own endpoint URLs from it, so it must be the real https:// URL.
APP_BASE_URL=https://your-app.vercel.app

# Signs session cookies (HMAC-SHA256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# --- Alpaca Broker API (LIVE — accounts, ACH, custody) -----------------------
# Sandbox only: https://broker-app.alpaca.markets -> Sandbox -> API Keys.
# Use "Legacy" credentials, which are a key id + secret used with HTTP Basic.
#
# This is the ACCOUNT and MONEY side: opening brokerage accounts, redeeming
# Plaid processor tokens into ACH relationships, and pulling deposits.
ALPACA_BROKER_KEY_ID=
ALPACA_BROKER_SECRET=
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets

# Shared secret between scripts/alpaca-bridge.ts and /api/webhooks/alpaca.
#
# Alpaca's Broker sandbox offers no webhook registration (verified: /v1/webhooks,
# /v2/webhooks and /v1/events/subscriptions all 404). Its push transport is SSE,
# so the bridge holds the stream open and posts each event into our endpoint,
# signed with this secret. Generate it the same way as SESSION_SECRET.
ALPACA_WEBHOOK_SECRET=

# --- Alpaca Paper Trading (LIVE — order execution) ---------------------------
# A SEPARATE credential from the Broker keys above, and separately required.
# Broker sandbox accounts cannot place orders without funded buying power, and
# ACH there settles only on trading days, so orders route to the paper venue
# instead. Without these, every invest attempt fails at the broker rather than
# in our code, which is a confusing way to discover a missing key.
#
# Get them from https://app.alpaca.markets -> Paper Trading -> API Keys.
# The key id starts with "PK". The code refuses anything that does not, so a
# live key pasted here is rejected rather than used.
ALPACA_PAPER_KEY_ID=PK...
ALPACA_PAPER_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Market data host, for closing prices. Optional — this is the default.
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Plaid (LIVE — bank linking) ---------------------------------------------
# Sandbox keys: https://dashboard.plaid.com -> Developers -> Keys
#
# The Alpaca processor integration must be enabled at
# https://dashboard.plaid.com/developers/integrations, otherwise
# /processor/token/create returns INVALID_PRODUCT and no ACH relationship can
# be created.
#
# NOTE: Plaid has no webhook secret, and PLAID_WEBHOOK_SECRET is not read
# anywhere in this codebase. Plaid signs webhooks with an ES256 JWT, and
# verification fetches Plaid's public key using the client id and secret below.
# If you have a PLAID_WEBHOOK_SECRET in your .env.local it is doing nothing and
# can be deleted.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Persona (LIVE — identity verification) ----------------------------------
# Sandbox keys: Persona dashboard -> API. Template id starts with itmpl_.
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=itmpl_...

# Persona dashboard -> Webhooks -> add
#   https://<APP_BASE_URL>/api/webhooks/persona
# and paste the signing secret it issues here. Without it, deliveries are
# recorded as `unverifiable` and deliberately NOT processed — an unverified
# identity decision must never move money.
PERSONA_WEBHOOK_SECRET=

# --- Custodian simulator (SIMULATED, and declared as such) -------------------
# There is no third-party custodian in this build. The simulator produces the
# morning positions/cash/transactions file that reconciliation diffs against,
# including the awkward cases: a late dividend, a corrected close, a tampered
# position. /integrations lists it as SIMULATED rather than implying a provider.
#
# This secret signs that file so it arrives the way a real custodian feed would,
# through the same verification path. Generate it like SESSION_SECRET.
CUSTODIAN_SIM_SECRET=

# --- MCP server (optional) ---------------------------------------------------
# Identity the MCP agent proposes under. Must begin with "agent:" — the approval
# queue uses that prefix to tell a proposal from a human request, and the
# executor refuses any decision made by an identity starting with it.
# Defaults to agent:mcp if unset.
MCP_AGENT_ID=agent:mcp

# =============================================================================
# NOT set by you:
#
#   VERCEL_OIDC_TOKEN   injected by the Vercel CLI during `vercel dev` / `vercel
#                       env pull`. It appears in .env.local automatically and is
#                       not read by this codebase. Leave it alone.
#   NODE_ENV            set by Next.js.
# =============================================================================
